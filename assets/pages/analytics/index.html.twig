{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{%- set page_measure = false -%}

{#- What is going on now first, whatever the period and the audience; then
    the audience and the period, which every part below follows: the figures
    and the tables add up the audience chosen, the charts read the period
    again when it changes. -#}
{%- block page_body -%}

    <h2>{{ '@page::section.now' | trans }}</h2>
    <p class="lead">{{ '@page::now_intro' | trans }}</p>
    {#- The key figures of now, then its course beside its latest pages:
        both read again every minute while the page is seen, once between
        them. -#}
    {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-now', { summary: today.summary, part: 'figures' }) }}
    <div class="grid--aside">
        {#- The window chosen without a script: the other chart is hidden,
            and drawn when shown, a chart waiting to be seen. -#}
        <div class="block block--padded analytics--today">
            <div class="radio-group radio-group--segmented" role="radiogroup">
                {%- for window in today.windows -%}
                    <div class="radio-option">
                        <input class="form--radio" type="radio" name="analytics-today" id="analytics-today-{{ window }}h"
                               value="{{ window }}h"{% if loop.first %} checked{% endif %}>
                        <label class="form--radio-label" for="analytics-today-{{ window }}h">{{ ('@page::now.window_' ~ window ~ 'h') | trans }}</label>
                    </div>
                {%- endfor -%}
            </div>
            {%- for window in today.windows -%}
                <div class="analytics--today-chart analytics--today-chart--{{ window }}h">
                    {{ chart('bar', {}, { source: today_chart, scope: window ~ 'h', stacked: true, lazy: not loop.first, poll: 60 }) }}
                </div>
            {%- endfor -%}
        </div>

        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-now', { summary: today.summary, part: 'latest' }) }}
    </div>

    {#- What every part below follows: the audience at the start of the bar,
        the period at its end. -#}
    <div class="toolbar toolbar--wrap toolbar--flush">
        <div class="toolbar--group">
            {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-audience-nav') }}
        </div>
        <div class="toolbar--group">
            {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/period-nav', {
                value: '30d',
                hashKey: 'period',
                rolling: [7, 30, 90],
            }) }}
        </div>
    </div>

    {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-totals') }}

    {#- The raw traffic, whatever the audience chosen: what the filter leaves
        out shows here. -#}
    <h2>{{ '@page::section.composition' | trans }}</h2>
    <p class="lead">{{ '@page::composition_intro' | trans }}</p>
    <div class="block block--padded">
        {{ chart('area', {}, { source: composition_chart, period: true, stacked: true, lazy: false }) }}
    </div>

    <h2>{{ '@page::section.traffic' | trans }}</h2>
    <p class="lead">{{ '@page::people_only' | trans }}</p>
    <div class="block block--padded">
        {{ chart('area', {}, { source: traffic_chart, period: true }) }}
    </div>

    <h2>{{ '@page::section.geography' | trans }}</h2>
    <div class="grid grid--2 analytics--tables">
        <div class="block block--padded">
            {{ chart('map', {}, { source: countries_chart, period: true, height: '22rem' }) }}
            {#- DB-IP's licence (CC BY 4.0) asks to be named where its countries are shown. -#}
            <p class="text-tertiary analytics--credit"><a href="https://db-ip.com" target="_blank" rel="noopener">IP Geolocation by DB-IP</a></p>
        </div>
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'country' }) }}
    </div>

    <h2>{{ '@page::section.origin' | trans }}</h2>
    <p class="lead">{{ '@page::origin_intro' | trans }}</p>
    <div class="grid grid--2 analytics--tables">
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'source' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'search_engine' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'referrer' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'keyword' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'campaign' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'device' }) }}
    </div>

    {#- The routes, a line whatever the language of a page, beside its
        addresses — one under the other where the row is too narrow. -#}
    <h2>{{ '@page::section.pages' | trans }}</h2>
    <div class="grid grid--2 analytics--tables">
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'route' }) }}
        {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'page' }) }}
    </div>

    {#- Every robot, whatever the audience chosen: the people have none. -#}
    <h2>{{ '@page::section.robots' | trans }}</h2>
    <p class="lead">{{ '@page::robots_intro' | trans }}</p>
    {{ vue(render_pass, '@WexampleSymfonyAnalyticsDsBundle/components/analytics-breakdown-table', { dimension: 'robot', audience: 'robots' }) }}

    {%- if storage_size is not null -%}
        <p class="text-tertiary analytics--storage">{{ '@page::storage' | trans({
            '%size%': storage_size | file_bytes,
            '%human%': retention.human,
            '%suspect%': retention.suspect,
            '%declared%': retention.declared,
        }) }}</p>
    {%- endif -%}
{%- endblock -%}
